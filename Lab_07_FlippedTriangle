package Lab_07;

public class Lab_07_FlippedTriangle {

    public static void main(String[] args) {

        for(int row = 6; row >= 1; row--)
        {
            for(int col = 1; col <= row; col++)
            {
                System.out.print("*");
            }
            System.out.println();
        }
    }
}
